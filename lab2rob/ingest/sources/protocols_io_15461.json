    "previous_guid": "93778190BD3111E88CE427F34D7B9B60",
    "section": "EQUAL VOLUME POOLING",
    "section_color": null,
    "section_duration": 0,
    "is_substep": false,
    "step": "Manually combine the multiple wells of the pool into one single DNA lo-bind tube. Mix.",
