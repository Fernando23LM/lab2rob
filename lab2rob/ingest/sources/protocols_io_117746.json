    "section_color": "#84CE84",
    "section_duration": 300,
    "is_substep": false,
    "step": "Calculate how much volume (in units of microliters) should now be on each dot: \n\n\n\n<table class=\"component-table\">\n<thead>\n<tr>\n%s</tr>\n</thead>\n<tbody>\n%s\n</tbody>\n</table>\r\n \n",
