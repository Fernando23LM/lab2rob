   },
   {
    "id": 1023297,
    "guid": "BAC28F20EF0111EA8C509F5B7AE9A43F",
    "previous_id": 1023296,
    "previous_guid": "AB40FC30EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": false,
    "step": "Sample Transfer\nUse the transfer pipette to transfer fluid from the vial to the tube.",
    "data": null,
    "protocol_id": 41618,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "8",
    "cases": [],
    "critical": null
   },
   {
    "id": 1023300,
    "guid": "F816C8F0EF0111EA8C509F5B7AE9A43F",
    "previous_id": 1023297,
    "previous_guid": "BAC28F20EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": true,
    "step": "FIRMLY squeeze the top bulb of the transfer pipette.",
    "data": null,
    "protocol_id": 41618,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "8.1",
    "cases": [],
