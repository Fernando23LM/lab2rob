    "previous_id": 1023277,
    "previous_guid": "3D4BB940EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": false,
    "step": "Sample preparation and set-up\n",
    "data": null,
    "protocol_id": 41618,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "7",
    "cases": [],
