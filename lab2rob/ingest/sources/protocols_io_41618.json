   {
    "id": 1023292,
    "guid": "8B800490EF0111EA8C509F5B7AE9A43F",
    "previous_id": 1023279,
    "previous_guid": "64EF46B0EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": true,
    "step": "Remove the reaction tube from the foil pouch labelled \u201creaction tube.\u201d Place it in the smaller well\u00a0of the sample prep block attached to the Harmony instrument.",
    "data": null,
    "protocol_id": 41618,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "7.1",
    "cases": [],
    "critical": null
   },
   {
    "id": 1023293,
    "guid": "8F3655D0EF0111EA8C509F5B7AE9A43F",
    "previous_id": 1023292,
    "previous_guid": "8B800490EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": true,
    "step": "Remove the vial of test buffer from the foil pouch labelled \u201ctest buffer.\u201d Take the cap off and place the vial in the larger well\u00a0of the sample prep block.",
    "data": null,
    "protocol_id": 41618,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "7.2",
    "cases": [],
    "critical": null
   },
   {
    "id": 1023294,
    "guid": "98154D00EF0111EA8C509F5B7AE9A43F",
    "previous_id": 1023293,
    "previous_guid": "8F3655D0EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": true,
    "step": "Submerge the patient swab (after collecting the patient nasal sample) in the test buffer and swirl it 5 times, pressing it against the sides of the vial.\n",
    "data": null,
    "protocol_id": 41618,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "7.3",
    "cases": [],
    "critical": null
   },
   {
    "id": 1023295,
    "guid": "9FE85270EF0111EA8C509F5B7AE9A43F",
    "previous_id": 1023294,
    "previous_guid": "98154D00EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": true,
    "step": "Leave the swab in the test buffer for 30 seconds.\n 00:00:30  \n",
    "data": null,
    "protocol_id": 41618,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "7.4",
    "cases": [],
    "critical": null
   },
   {
    "id": 1023296,
    "guid": "AB40FC30EF0111EA8C509F5B7AE9A43F",
    "previous_id": 1023295,
    "previous_guid": "9FE85270EF0111EA8C509F5B7AE9A43F",
    "section": "<p>Test Procedure</p>",
    "section_color": "#E57785",
    "section_duration": 0,
    "is_substep": true,
    "step": "Rotate the swab head against the inside of the vial as you remove it. Dispose of the swab in a biohazardous waste container.",
    "data": null,
