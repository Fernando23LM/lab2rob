    "section": "<p>Prepare seeds</p>",
    "section_color": "#A492FF",
    "section_duration": 86400,
    "is_substep": false,
    "step": "Sterilize the Arabidopsis seeds (no more than +/- 400 seeds) in 2ml Eppendorf tube with 1 ml of 50% household bleach (diluted with MQ water) - keep for 10-20 minutes",
    "data": null,
    "protocol_id": 31494,
    "case_id": 0,
    "critical_ids": "0",
    "duration": 0,
    "original_id": 0,
    "number": "1",
