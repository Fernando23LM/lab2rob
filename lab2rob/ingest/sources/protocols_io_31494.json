   },
   {
    "id": 866734,
    "guid": "2B7163B0305B11EAA00BC547A53CE423",
    "previous_id": 866733,
    "previous_guid": "F2D50CA0305A11EAA00BC547A53CE423",
    "section": "<p>Prepare seeds</p>",
    "section_color": "#A492FF",
    "section_duration": 86400,
    "is_substep": false,
    "step": "Wash the seeds with 2 ml of sterile MQ water - 5 to 8 times - preferably in the laminar hood",
