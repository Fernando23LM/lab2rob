    "guid": "8C26628395654CF6B652021F3DC80D86",
    "previous_id": 880994,
    "previous_guid": "252C0634AE39489BB4D90773D503A791",
    "section": "<p><strong>Prepare the serial dilutions of Texas Red in a 96-well plate</strong></p>",
    "section_color": "#94EBFF",
    "section_duration": 0,
    "is_substep": false,
    "step": "Repeat dilution series for rows B, C, D",
    "data": null,
    "protocol_id": 32907,
    "case_id": 0,
