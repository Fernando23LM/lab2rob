  "steps": [
   {
    "id": 505306,
    "guid": "06696FF4C28D4264929EAD2C9322A7F8",
    "previous_id": 0,
    "previous_guid": null,
    "section": "Mother solution",
    "section_color": null,
    "section_duration": 0,
    "is_substep": false,
    "step": "Oligonucleotides used for molecular biology will be called dNTP (deoxyribonucleotide triphosphate) set. Most commonly companies distribute the aliquotted 100mM dNTP set separately in 4x250uL, dATP, dTTP, dCTP and dGTP.",
    "data": null,
    "protocol_id": 5969,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "1",
    "cases": [],
    "critical": null
   },
   {
    "id": 505307,
    "guid": "E663E0F0A9914789BB478CB6735A1824",
    "previous_id": 505306,
    "previous_guid": "06696FF4C28D4264929EAD2C9322A7F8",
    "section": "Stock solution",
    "section_color": null,
    "section_duration": 0,
    "is_substep": false,
    "step": "Equal proportions of dNTP volume are mixed to make up the stock solution. The concentration of 100 mM is maintained. I recommend that you use a volume of 50uL each to get 200uL of final volume, but varies according to your need. This solution should be stored frozen and only thawed when preparing the working solution. This reduces the need for defrosting the stock solution using the stock solution as an intermediate.\n",
    "data": null,
    "protocol_id": 5969,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "2",
    "cases": [],
    "critical": null
   },
   {
    "id": 505308,
    "guid": "6FB187142C6344E0893C6A1F913C104B",
    "previous_id": 505307,
    "previous_guid": "E663E0F0A9914789BB478CB6735A1824",
    "section": "Work solution",
    "section_color": null,
    "section_duration": 0,
    "is_substep": false,
    "step": "For this solution we will reduce to 10mM with 1:10 proportion of water.\n\nStore frozen.",
    "data": null,
