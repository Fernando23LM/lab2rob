    "guid": "BAC0EE409DBC11EA814529A47F98D72C",
    "previous_id": 0,
    "previous_guid": null,
    "section": "<p>Detaching and collecting cells</p>",
    "section_color": "#A492FF",
    "section_duration": 0,
    "is_substep": false,
    "step": "Remove the old culture media using a sterile aspirator pipette.",
    "data": null,
    "protocol_id": 37443,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "1",
