    "section": "<p>Re-seeding cells</p>",
    "section_color": "#94EBFF",
    "section_duration": 0,
    "is_substep": false,
    "step": "Transfer the flask to a  37 \u00b0C  , 5% CO2 incubator. Agitate the flask gently back and forth and side to side to ensure even distribution of cells across the flask.",
    "data": null,
