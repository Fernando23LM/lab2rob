    "previous_guid": "695F887A7CB84317A0538FC5FD9F44D0",
    "section": "<p>Measuring liquid dispensing</p>",
    "section_color": "#94EBFF",
    "section_duration": 0,
    "is_substep": false,
    "step": "Submerge the pipette tip in the water about 2 mm below the menicus for small volume micropipettes (&lt;20 \u03bcL) and 4 to 6 mm for larger volume micropipettes. ",
    "data": null,
    "protocol_id": 31557,
    "case_id": 0,
    "critical_ids": "",
