    "previous_id": 709269,
    "previous_guid": "8AA6F0D0323611E9B885BB6FFDC33622",
    "section": null,
    "section_color": null,
    "section_duration": 0,
    "is_substep": false,
    "step": " Incubate at  37 \u00b0C  overnight.\n",
    "data": null,
    "protocol_id": 20446,
    "case_id": 0,
    "critical_ids": "",
    "duration": 0,
    "original_id": 0,
    "number": "12",
